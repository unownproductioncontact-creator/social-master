// Worker Cloudflare des médias de Social Master (CLAUDE.md §36).
// Déploiement : npx wrangler deploy (depuis ce dossier). Secrets : SIGNING_SECRET, PUSH_SECRET
// (npx wrangler secret put …), jamais dans ce fichier.
{
  "name": "social-master-media",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "social-master" }],
  "vars": {
    // Fichiers de vérification d'URL TikTok servis à la racine : { "tiktok<jeton>.txt": "<contenu>" }.
    // tiktokCAvdb… = environnement Production, tiktokTEonV… = Sandbox (vérifiés le 11/10/2026).
    "TIKTOK_VERIFICATIONS": "{\"tiktokCAvdbYxV7kUQxKi6sL93x3tLdgABzs7E.txt\":\"tiktok-developers-site-verification=CAvdbYxV7kUQxKi6sL93x3tLdgABzs7E\",\"tiktokTEonVLtxRvDlbJftJOqK90XXI0oHY8VG.txt\":\"tiktok-developers-site-verification=TEonVLtxRvDlbJftJOqK90XXI0oHY8VG\"}",
    // Active /selftest/push (mesure de débit, utile seulement pour re-mesurer) ; "0" en production
    // depuis le 11/10/2026 (CLAUDE.md §36, point 6).
    "SELFTEST": "0"
  },
  "observability": { "enabled": true }
}
