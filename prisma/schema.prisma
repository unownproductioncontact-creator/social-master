generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  // Page Facebook (CLAUDE.md §40) : publication directe via l'API Graph, jeton de Page.
  FACEBOOK
}

enum SocialAccountType {
  BUSINESS
  CREATOR
  PERSONAL
}

enum SocialAccountStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
}

enum MediaStatus {
  UPLOADING
  READY
  FAILED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PARTIALLY_PUBLISHED
  PUBLISHED
  FAILED
}

enum PostContentType {
  REEL
  IMAGE
  CAROUSEL
  STORY
  TIKTOK_VIDEO
  TIKTOK_PHOTO
  YOUTUBE_SHORT
  // Page Facebook (§40) : Reel (vidéo verticale de 3 à 90 s), autre vidéo, une photo, plusieurs photos.
  FACEBOOK_REEL
  FACEBOOK_VIDEO
  FACEBOOK_PHOTO
  FACEBOOK_PHOTOS
}

enum PublishMode {
  AUTO
  TIKTOK_DRAFT
}

enum PostTargetStatus {
  PENDING
  PROCESSING
  PUBLISHED
  SENT_TO_INBOX
  FAILED
  // YouTube détient déjà la vidéo, en privé avec une date de publication (status.publishAt) : c'est
  // YouTube qui la rend publique à l'heure prévue ; une vérification passe ensuite la cible en
  // PUBLISHED. Ne jamais la renvoyer (comme PUBLISHED). CLAUDE.md §38.
  PLATFORM_SCHEDULED
}

enum PublishJobState {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

// Miniature personnalisée d'une vidéo YouTube (CLAUDE.md §37) : statut SÉPARÉ de celui de la vidéo —
// un échec de la miniature ne fait jamais échouer la publication.
enum ThumbnailStatus {
  PENDING
  SET
  FAILED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String?
  timezone           String   @default("Europe/Paris")
  // Purge automatique optionnelle des médias déjà publiés (null = désactivé). Voir
  // src/lib/media-retention.ts (sélection pure) + src/worker/media-cleanup-job.ts (passe de purge).
  mediaRetentionDays Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  posts          Post[]
  activityLogs   ActivityLog[]
  oauthAuthCodes OAuthAuthCode[]
  oauthTokens    OAuthToken[]

  @@map("users")
}

model SocialAccount {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          Platform
  platformAccountId String
  username          String
  displayName       String?
  avatarUrl         String?
  accountType       SocialAccountType?
  accessTokenEnc    String
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  refreshExpiresAt  DateTime?
  grantedScopes     String[]            @default([])
  status            SocialAccountStatus @default(ACTIVE)
  lastCheckedAt     DateTime?
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  postTargets PostTarget[]

  instagramMedia InstagramMedia[]
  instagramDays  InstagramAccountDay[]

  @@unique([platform, platformAccountId])
  @@index([userId])
  @@map("social_accounts")
}

model MediaAsset {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey   String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Float?
  thumbnailKey String?
  status       MediaStatus @default(UPLOADING)
  checksum     String?
  // Import par lien (connecteur Claude, CLAUDE.md §30) : lien d'origine + erreur lisible si l'import échoue.
  importUrl    String?
  importError  String?
  createdAt    DateTime    @default(now())

  postMedia       PostMedia[]
  // Cibles qui utilisent ce média comme miniature YouTube ou couverture de Reel (CLAUDE.md §37).
  coverForTargets PostTarget[] @relation("PostTargetCover")

  @@index([userId])
  @@map("media_assets")
}

model Post {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  caption     String     @default("")
  hashtags    String[]   @default([])
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  scheduledTz String     @default("Europe/Paris")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  postMedia   PostMedia[]
  postTargets PostTarget[]

  @@index([userId])
  @@index([status, scheduledAt])
  @@map("posts")
}

model PostMedia {
  id           String     @id @default(cuid())
  postId       String
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@unique([postId, mediaAssetId])
  @@index([postId])
  @@map("post_media")
}

model PostTarget {
  id                String           @id @default(cuid())
  postId            String
  post              Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccountId   String
  socialAccount     SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform          Platform
  contentType       PostContentType
  publishMode       PublishMode      @default(AUTO)
  captionOverride   String?
  // Horaire effectif de publication PROPRE à cette cible, en UTC (peut différer de Post.scheduledAt :
  // ex. TikTok à H et Instagram à H+5min). Null tant que le post n'est pas programmé (voir scheduler.ts).
  scheduledAt       DateTime?
  platformOptions   Json             @default("{}")
  status            PostTargetStatus @default(PENDING)
  platformPostId    String?
  platformPostUrl   String?
  publishedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  // Brouillon TikTok (inbox) : `publish_id` renvoyé par TikTok une fois le fichier ENTIÈREMENT transmis
  // (vidéo) ou l'init acceptée (photo). Tant qu'il est renseigné, un retry ne renvoie JAMAIS le média :
  // il reprend seulement la vérification du statut (sinon un traitement TikTok lent = brouillons en
  // double, constaté le 30/09/2026). Remis à null à chaque (re)programmation. Voir CLAUDE.md §27.
  tiktokPublishId   String?
  tiktokUploadedAt  DateTime?
  // Image de la médiathèque utilisée comme miniature (YouTube, `thumbnails.set` juste après la mise en
  // ligne) ou comme couverture de Reel (Instagram, `cover_url`). Relation et non JSON : un média
  // référencé ici est « utilisé » (jamais purgé comme inutilisé) ; sa suppression détache simplement
  // l'image (SetNull), la vidéo part alors sans miniature. Voir CLAUDE.md §37.
  coverMediaAssetId String?
  coverMedia        MediaAsset?      @relation("PostTargetCover", fields: [coverMediaAssetId], references: [id], onDelete: SetNull)
  // YouTube uniquement : état de la miniature (null = aucune demandée). PENDING = à poser (avant
  // publication, ou nouvel essai programmé) ; SET = posée ; FAILED = abandon, raison dans thumbnailError.
  thumbnailStatus   ThumbnailStatus?
  thumbnailError    String?
  thumbnailSetAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  publishJobs PublishJob[]

  @@index([postId])
  @@index([socialAccountId])
  @@index([status])
  @@index([coverMediaAssetId])
  @@map("post_targets")
}

model PublishJob {
  id             String          @id @default(cuid())
  postTargetId   String
  postTarget     PostTarget      @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  runAt          DateTime
  attempt        Int             @default(0)
  maxAttempts    Int             @default(3)
  state          PublishJobState @default(WAITING)
  idempotencyKey String          @unique
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([postTargetId])
  @@index([state, runAt])
  @@map("publish_jobs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Connecteur Claude (serveur MCP distant, CLAUDE.md §29) — serveur d'autorisation OAuth 2.1 minimal :
// enregistrement dynamique des clients (RFC 7591), code + PKCE S256, jetons opaques stockés HASHÉS
// (SHA-256) — jamais en clair en base. Révocation depuis Paramètres.
// ---------------------------------------------------------------------------

/// Client OAuth enregistré dynamiquement (ex. Claude) — `id` = client_id.
model OAuthClient {
  id                      String   @id @default(cuid())
  name                    String
  redirectUris            String[]
  // "none" (client public + PKCE) ou "client_secret_post"/"client_secret_basic" (secret hashé).
  tokenEndpointAuthMethod String   @default("none")
  secretHash              String?
  createdAt               DateTime @default(now())

  authCodes OAuthAuthCode[]
  tokens    OAuthToken[]

  @@map("oauth_clients")
}

/// Code d'autorisation : usage unique, 10 min, hashé ; PKCE S256 obligatoire.
model OAuthAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scope         String      @default("")
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@map("oauth_auth_codes")
}

/// Accès accordé à un client : jeton d'accès (1 h) + jeton de rafraîchissement (90 j, rotation), hashés.
model OAuthToken {
  id               String      @id @default(cuid())
  clientId         String
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash  String      @unique
  refreshTokenHash String      @unique
  scope            String      @default("")
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime    @default(now())

  @@index([userId])
  @@map("oauth_tokens")
}

/// Statistiques Instagram (CLAUDE.md §43) : un média du compte connecté, publié par Social Master ou non
/// (lien avec un post : PostTarget.platformPostId = mediaId). Dernières valeurs lues ici, historique dans
/// InstagramMediaSnapshot. Une métrique que l'API ne renvoie pas reste null : jamais 0 par défaut.
model InstagramMedia {
  id                String        @id @default(cuid())
  socialAccountId   String
  socialAccount     SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  mediaId           String
  mediaType         String?
  mediaProductType  String?
  permalink         String?
  caption           String?
  postedAt          DateTime
  views             Int?
  reach             Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saved             Int?
  totalInteractions Int?
  // Valeurs brutes de Meta : unité du temps de visionnage et échelle du taux de zapping non documentées
  // (vérifiées sur un vrai relevé, voir CLAUDE.md §43).
  avgWatchTime      Float?
  totalWatchTime    Float?
  skipRate          Float?
  missingMetrics    String[]      @default([])
  statsFetchedAt    DateTime?
  statsError        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  snapshots InstagramMediaSnapshot[]

  @@unique([socialAccountId, mediaId])
  @@index([socialAccountId, postedAt])
  @@map("instagram_media")
}

/// Relevé daté des statistiques d'un média : l'API ne donne que le cumul à l'instant T, la courbe dans le
/// temps (vues à 6 h, 24 h, 7 j…) se reconstruit avec ces relevés. `metrics` = seulement ce qui a été renvoyé.
model InstagramMediaSnapshot {
  id               String         @id @default(cuid())
  instagramMediaId String
  instagramMedia   InstagramMedia @relation(fields: [instagramMediaId], references: [id], onDelete: Cascade)
  fetchedAt        DateTime       @default(now())
  metrics          Json           @default("{}")

  @@index([instagramMediaId, fetchedAt])
  @@map("instagram_media_snapshots")
}

/// Statistiques du compte pour une journée (`day` = AAAA-MM-JJ). Relues pendant les jours qui suivent : Meta
/// annonce jusqu'à 48 h de retard. `metrics` garde tout ce qui a été renvoyé, `views`/`reach` servent à l'affichage.
model InstagramAccountDay {
  id              String        @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  day             String
  views           Int?
  reach           Int?
  metrics         Json          @default("{}")
  fetchedAt       DateTime      @default(now())

  @@unique([socialAccountId, day])
  @@map("instagram_account_days")
}
