generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum SocialAccountType {
  BUSINESS
  CREATOR
  PERSONAL
}

enum SocialAccountStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
}

enum MediaStatus {
  UPLOADING
  READY
  FAILED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PARTIALLY_PUBLISHED
  PUBLISHED
  FAILED
}

enum PostContentType {
  REEL
  IMAGE
  CAROUSEL
  STORY
  TIKTOK_VIDEO
  TIKTOK_PHOTO
  YOUTUBE_SHORT
}

enum PublishMode {
  AUTO
  TIKTOK_DRAFT
}

enum PostTargetStatus {
  PENDING
  PROCESSING
  PUBLISHED
  SENT_TO_INBOX
  FAILED
}

enum PublishJobState {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  timezone     String   @default("Europe/Paris")
  // Purge automatique optionnelle des médias déjà publiés (null = désactivé). Voir
  // src/lib/media-retention.ts (sélection pure) + src/worker/media-cleanup-job.ts (passe de purge).
  mediaRetentionDays Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  posts          Post[]
  activityLogs   ActivityLog[]
  oauthAuthCodes OAuthAuthCode[]
  oauthTokens    OAuthToken[]

  @@map("users")
}

model SocialAccount {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          Platform
  platformAccountId String
  username          String
  displayName       String?
  avatarUrl         String?
  accountType       SocialAccountType?
  accessTokenEnc    String
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  refreshExpiresAt  DateTime?
  grantedScopes     String[]            @default([])
  status            SocialAccountStatus @default(ACTIVE)
  lastCheckedAt     DateTime?
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  postTargets PostTarget[]

  @@unique([platform, platformAccountId])
  @@index([userId])
  @@map("social_accounts")
}

model MediaAsset {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey   String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Float?
  thumbnailKey String?
  status       MediaStatus @default(UPLOADING)
  checksum     String?
  createdAt    DateTime    @default(now())

  postMedia PostMedia[]

  @@index([userId])
  @@map("media_assets")
}

model Post {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  caption     String     @default("")
  hashtags    String[]   @default([])
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  scheduledTz String     @default("Europe/Paris")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  postMedia   PostMedia[]
  postTargets PostTarget[]

  @@index([userId])
  @@index([status, scheduledAt])
  @@map("posts")
}

model PostMedia {
  id           String     @id @default(cuid())
  postId       String
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@unique([postId, mediaAssetId])
  @@index([postId])
  @@map("post_media")
}

model PostTarget {
  id              String           @id @default(cuid())
  postId          String
  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform        Platform
  contentType     PostContentType
  publishMode     PublishMode      @default(AUTO)
  captionOverride String?
  // Horaire effectif de publication PROPRE à cette cible, en UTC (peut différer de Post.scheduledAt :
  // ex. TikTok à H et Instagram à H+5min). Null tant que le post n'est pas programmé (voir scheduler.ts).
  scheduledAt     DateTime?
  platformOptions Json             @default("{}")
  status          PostTargetStatus @default(PENDING)
  platformPostId  String?
  platformPostUrl String?
  publishedAt     DateTime?
  errorCode       String?
  errorMessage    String?
  // Brouillon TikTok (inbox) : `publish_id` renvoyé par TikTok une fois le fichier ENTIÈREMENT transmis
  // (vidéo) ou l'init acceptée (photo). Tant qu'il est renseigné, un retry ne renvoie JAMAIS le média :
  // il reprend seulement la vérification du statut (sinon un traitement TikTok lent = brouillons en
  // double, constaté le 30/09/2026). Remis à null à chaque (re)programmation. Voir CLAUDE.md §27.
  tiktokPublishId  String?
  tiktokUploadedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  publishJobs PublishJob[]

  @@index([postId])
  @@index([socialAccountId])
  @@index([status])
  @@map("post_targets")
}

model PublishJob {
  id             String          @id @default(cuid())
  postTargetId   String
  postTarget     PostTarget      @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  runAt          DateTime
  attempt        Int             @default(0)
  maxAttempts    Int             @default(3)
  state          PublishJobState @default(WAITING)
  idempotencyKey String          @unique
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([postTargetId])
  @@index([state, runAt])
  @@map("publish_jobs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Connecteur Claude (serveur MCP distant, CLAUDE.md §29) — serveur d'autorisation OAuth 2.1 minimal :
// enregistrement dynamique des clients (RFC 7591), code + PKCE S256, jetons opaques stockés HASHÉS
// (SHA-256) — jamais en clair en base. Révocation depuis Paramètres.
// ---------------------------------------------------------------------------

/// Client OAuth enregistré dynamiquement (ex. Claude) — `id` = client_id.
model OAuthClient {
  id                      String   @id @default(cuid())
  name                    String
  redirectUris            String[]
  // "none" (client public + PKCE) ou "client_secret_post"/"client_secret_basic" (secret hashé).
  tokenEndpointAuthMethod String   @default("none")
  secretHash              String?
  createdAt               DateTime @default(now())

  authCodes OAuthAuthCode[]
  tokens    OAuthToken[]

  @@map("oauth_clients")
}

/// Code d'autorisation : usage unique, 10 min, hashé ; PKCE S256 obligatoire.
model OAuthAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scope         String      @default("")
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@map("oauth_auth_codes")
}

/// Accès accordé à un client : jeton d'accès (1 h) + jeton de rafraîchissement (90 j, rotation), hashés.
model OAuthToken {
  id               String      @id @default(cuid())
  clientId         String
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash  String      @unique
  refreshTokenHash String      @unique
  scope            String      @default("")
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime    @default(now())

  @@index([userId])
  @@map("oauth_tokens")
}
